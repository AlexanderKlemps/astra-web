# Copy outside version control, replace placeholders, then pass --env-file.
ASTRA_API_KEY=replace-with-a-secret
# API and proxy images are built locally by Compose.
ASTRA_BASE_IMAGE=alexanderklemps/astra-web:astra-2026-10-09
# Use the actual existing volume name to preserve current data.
ASTRA_DATA_VOLUME=astra-production-data
ASTRA_API_REPLICAS=2
ASTRA_API_MEMORY=2G
ASTRA_MAX_CONCURRENT_JOBS=1
ASTRA_MAX_MPI_PROCESSES=1
# HTTPS reverse proxy on the Docker host forwards /astra/ to this address.
ASTRA_HTTP_BIND=127.0.0.1
ASTRA_HTTP_PORT=8080
